# WordZoo — environment variables
# Copy to .env.local for development. Production values live in the Vercel
# dashboard (project `wordzoo`). Never commit real values.

# --- Database (Neon Postgres) ---
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# --- Auth (NextAuth v5, Google OAuth). Dev runs on port 8000. ---
AUTH_SECRET=generate-with-openssl-rand-base64-32
NEXTAUTH_SECRET=same-as-AUTH_SECRET
AUTH_URL=http://localhost:8000
NEXTAUTH_URL=http://localhost:8000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Comma-separated. Gates /admin/* and bypasses every spend guard and free-tier limit.
ADMIN_EMAILS=you@example.com

# --- AI ---
# Gemini (lib/ai/gemini.ts). Free tier is 20 requests/day per model, shared between
# the live tutor and every bulk script — see CLAUDE.md before running a seed.
GOOGLE_GEMINI_API_KEY=
# Google Cloud Text-to-Speech. Optional: without it (or with billing off on its
# project) /api/tts fails and the browser voice is used. Seeded clips still play.
GOOGLE_CLOUD_TTS_API_KEY=
# Stability AI for mnemonic illustrations (seed scripts + /api/mnemonics/*).
STABILITY_AI_API_KEY=

# --- Storage ---
BLOB_READ_WRITE_TOKEN=

# --- Stripe ---
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
STRIPE_WEBHOOK_SECRET=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:8000
# Bearer token every /api/cron/* route requires. Vercel supplies it for its own crons.
CRON_SECRET=
# Fine-grained GitHub PAT, Contents: write on Benji-cpu/wordzoo — used by
# /api/cron/nightly-routine to commit digests/YYYY-MM-DD.json.
GITHUB_PAT_REPO_WRITE=

# --- Pedagogy v2 slices (lib/pedagogy/flags.ts) ---
# The drill slices (distractors, production, mastery, restructure, cloze) are
# always on. This var only gates the ones that spend money or need a mic.
# PEDAGOGY_V2_SLICES=conversation,speech

# --- Optional: retention email (Resend). Without it every send is skipped. ---
# RESEND_API_KEY=
# EMAIL_FROM=WordZoo <hello@yourdomain.com>
# ADMIN_EMAIL=you@example.com
